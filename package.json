{
  "name": "speedrun-app",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "build/api/server.js",
  "scripts": {
    "test": "node --no-warnings --experimental-vm-modules node_modules/jest/bin/jest.js --forceExit --detectOpenHandles",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "tsoa": "tsoa spec-and-routes",
    "start-dev": "nodemon --ext ts,js,mjs,cjs,json --ignore './build/' --exec 'yarn tsoa && node --no-warnings=ExperimentalWarning --loader ts-node/esm src/server.ts'",
    "start": "yarn tsoa && node --no-warnings=ExperimentalWarning --loader ts-node/esm src/server.ts",
    "db:up": "docker compose up speedrun-db --build -d --wait",
    "db:down": "docker compose down speedrun-db",
    "coverage:merge": "cobertura-merge -o"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "inversify": "^6.0.2",
    "inversify-binding-decorators": "^4.0.0",
    "lodash": "^4.17.21",
    "mariadb": "^3.3.0",
    "node-gyp": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "superagent": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.1.1",
    "@jest/globals": "^29.7.0",
    "@openapitools/openapi-generator-cli": "^2.13.4",
    "@types/cors": "^2.8.17",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.12.7",
    "@types/superagent": "^8.1.7",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/yargs": "^17.0.32",
    "@typescript-eslint/parser": "^8.17.0",
    "cobertura-merge": "^1.0.4",
    "cpy-cli": "^5.0.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.16.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "mkdirp": "^3.0.1",
    "nodemon": "^3.1.7",
    "prettier": "^3.4.2",
    "rimraf": "^5.0.5",
    "supertest": "^7.0.0",
    "testcontainers": "^10.16.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.17.0"
  },
  "packageManager": "yarn@4.5.3"
}
